@using TaskFlow.Client.Services
@using TaskFlow.Client.Models
@inject TaskService TaskSvc
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Class="mr-2" />
            Edit Task
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudTextField @bind-Value="_title"
                      Label="Judul"
                      Variant="Variant.Outlined"
                      Class="mb-4"
                      Immediate="true"
                      Required="true" />

        <MudTextField @bind-Value="_description"
                      Label="Deskripsi"
                      Variant="Variant.Outlined"
                      Lines="4"
                      Class="mb-4" />

        <MudCheckBox @bind-Value="_isDone"
                     Label="Tandai sebagai selesai"
                     Color="Color.Success"
                     T="bool" />
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Batal</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Submit">
            Simpan
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public TaskResponse Task { get; set; } = null!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private string _title = "";
    private string _description = "";
    private bool _isDone;

    protected override void OnParametersSet()
    {
        _title = Task.Title;
        _description = Task.Description ?? "";
        _isDone = Task.IsDone;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            Snackbar.Add("Judul wajib diisi", Severity.Warning);
            return;
        }

        var ok = await TaskSvc.UpdateAsync(Task.Id, _title,
            string.IsNullOrWhiteSpace(_description) ? null : _description, _isDone);

        if (ok)
        {
            Snackbar.Add("Task diperbarui", Severity.Success);
            await OnSaved.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add("Gagal menyimpan", Severity.Error);
        }
    }
}