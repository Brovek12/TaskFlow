@page "/login"
@layout AuthLayout
@using TaskFlow.Client.Services
@inject AuthService Auth
@inject NavigationManager Nav

<MudPaper Class="pa-6" Elevation="3">
    <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-6">Login ke TaskFlow</MudText>

    @if (!string.IsNullOrEmpty(error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
    }

    <MudTextField @bind-Value="email" Label="Email" Variant="Variant.Outlined" Class="mb-3" />
    <MudTextField @bind-Value="password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="DoLogin" Class="mb-3">
        Login
    </MudButton>
    <MudButton Variant="Variant.Text" Color="Color.Secondary" FullWidth="true" OnClick="GoToRegister">
        Belum punya akun? Register
    </MudButton>
</MudPaper>

@code {
    private string email = "";
    private string password = "";
    private string? error;

    private async Task DoLogin()
    {
        var (ok, err) = await Auth.LoginAsync(email, password);
        if (ok) Nav.NavigateTo("/", forceLoad: true);
        else error = err;
    }

    private void GoToRegister() => Nav.NavigateTo("/register");
}