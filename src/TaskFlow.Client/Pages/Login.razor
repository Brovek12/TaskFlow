@page "/login"
@using TaskFlow.Client.Services
@inject AuthService Auth
@inject NavigationManager Nav

<div class="auth-wrapper">
    <div class="auth-card">
        <h3>Login ke TaskFlow</h3>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert">@error</div>
        }

        <input @bind="email" placeholder="Email" />
        <input @bind="password" type="password" placeholder="Password" />
        <button @onclick="DoLogin">Login</button>
        <button class="secondary" @onclick="GoToRegister">Belum punya akun? Register</button>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? error;

    private async Task DoLogin()
    {
        var (ok, err) = await Auth.LoginAsync(email, password);
        if (ok) Nav.NavigateTo("/", forceLoad: true);
        else error = err;
    }

    private void GoToRegister() => Nav.NavigateTo("/register");
}