@page "/tasks"
@using TaskFlow.Client.Services
@using TaskFlow.Client.Models
@using TaskFlow.Client.Dialogs
@inject TaskService TaskSvc
@inject AuthService Auth
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPaper Class="pa-6" Elevation="0" Outlined="true">
    <div class="d-flex align-center mb-4">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" Size="Size.Large" Class="mr-3" />
        <div>
            <MudText Typo="Typo.h5">Task Saya</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @(filteredTasks?.Count ?? 0) dari @(tasks?.Count ?? 0) task
            </MudText>
        </div>
        <MudSpacer />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog"
                   Size="Size.Medium"
                   DisableElevation="false">
            Tambah Task
        </MudButton>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@error</MudAlert>
    }

    <MudTextField @bind-Value="search"
                  Placeholder="Cari task berdasarkan judul atau deskripsi..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  IconSize="Size.Medium"
                  Immediate="true"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Class="mb-4"
                  Clearable="true" />

    <MudDataGrid T="TaskResponse"
                 Items="@filteredTasks"
                 Hover="true"
                 Dense="true"
                 Striped="true"
                 Bordered="false"
                 Elevation="0"
                 Breakpoint="Breakpoint.Sm"
                 Loading="@(tasks == null)"
                 LoadingProgressColor="Color.Primary">
        <Columns>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <MudCheckBox T="bool"
                                 Value="@context.Item.IsDone"
                                 ValueChanged="@(v => ToggleDone(context.Item))"
                                 Dense="true"
                                 Color="Color.Success" />
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.Title" Title="Judul">
                <CellTemplate>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@(context.Item.IsDone ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                                 Color="@(context.Item.IsDone ? Color.Success : Color.Default)"
                                 Size="Size.Small"
                                 Class="mr-2" />
                        <MudText Style="@(context.Item.IsDone ? "text-decoration: line-through; color: #9ca3af;" : "font-weight: 500;")">
                            @context.Item.Title
                        </MudText>
                    </div>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.Description" Title="Deskripsi">
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.Description))
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Description</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="opacity: 0.4">—</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.CreatedAt" Title="Dibuat">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                        @context.Item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>

            <TemplateColumn Title="Aksi" Sortable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => OpenEditDialog(context.Item))"
                                   Title="Edit" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteTask(context.Item.Id))"
                                   Title="Hapus" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <div class="text-center py-8">
                <MudIcon Icon="@Icons.Material.Outlined.Inbox" Size="Size.Large" Color="Color.Default" Style="opacity: 0.3" />
                <MudText Typo="Typo.body1" Class="mt-2 mud-text-secondary">Belum ada task</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Klik "Tambah Task" untuk memulai</MudText>
            </div>
        </NoRecordsContent>
        <LoadingContent>
            <div class="text-center py-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">Memuat task...</MudText>
            </div>
        </LoadingContent>
    </MudDataGrid>
</MudPaper>

@code {
    private List<TaskResponse>? tasks;
    private List<TaskResponse>? filteredTasks;
    private string search = "";
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (!await Auth.IsLoggedInAsync())
        {
            Nav.NavigateTo("/login");
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        tasks = await TaskSvc.GetAllAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (tasks == null)
        {
            filteredTasks = null;
            return;
        }

        IEnumerable<TaskResponse> q = tasks;

        if (!string.IsNullOrWhiteSpace(search))
        {
            var s = search.ToLowerInvariant();
            q = q.Where(t =>
                t.Title.ToLowerInvariant().Contains(s) ||
                (t.Description ?? "").ToLowerInvariant().Contains(s));
        }

        filteredTasks = q.ToList();
    }

   private async Task OpenCreateDialog()
{
    var parameters = new DialogParameters<CreateTaskDialog>
    {
        { x => x.OnSaved, EventCallback.Factory.Create(this, LoadAsync) }
    };

    var options = new DialogOptions
    {
        MaxWidth = MaxWidth.Medium,      // ← ganti dari Small ke Medium (960px)
        FullWidth = true,
        CloseOnEscapeKey = true,
        CloseButton = true
    };

    var dialog = await DialogService.ShowAsync<CreateTaskDialog>("", parameters, options);
    await dialog.Result;
}
    private async Task OpenEditDialog(TaskResponse task)
    {
        var parameters = new DialogParameters<EditTaskDialog>
        {
            { x => x.Task, task },
            { x => x.OnSaved, EventCallback.Factory.Create(this, LoadAsync) }
        };

        var dialog = await DialogService.ShowAsync<EditTaskDialog>("Edit Task", parameters);
        await dialog.Result;
    }

    private async Task ToggleDone(TaskResponse t)
    {
        await TaskSvc.UpdateAsync(t.Id, t.Title, t.Description, !t.IsDone);
        await LoadAsync();
    }

    private async Task DeleteTask(int id)
    {
        var ok = await TaskSvc.DeleteAsync(id);
        if (ok)
        {
            Snackbar.Add("Task dihapus", Severity.Success);
            await LoadAsync();
        }
        else
        {
            error = "Gagal menghapus";
        }
    }
}